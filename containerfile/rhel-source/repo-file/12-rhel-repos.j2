#% desc: RHEL packages from a user-provided redhat.repo (COPY from build context)
# Replace /etc/yum.repos.d/redhat.repo with a file from the build context
# instead of relying on host RHSM entitlements. Pass REDHAT_REPO=<path>
# (relative to the repo root) at generate time.
# It must supply repos pinned to the RHEL minor version matching the RHCOS
# kernel (the EUS repos that the rhsm variant enables).
COPY {{ REDHAT_REPO }} /etc/yum.repos.d/redhat.repo
RUN source /etc/os-release && \
  echo "${VERSION_ID}" > /etc/dnf/vars/releasever
