#% desc: Install kernel-module RPMs compiled in the builder stage
RUN --mount=type=bind,from=builder,source=/root,target=/tmp/builder \
  ls /tmp/builder/rpmbuild/RPMS/aarch64 && \
  rpm -ivh --nodeps /tmp/builder/rpmbuild/RPMS/aarch64/*.rpm && \
  \
  dnf download doca-runtime-kernel && \
  rpm --nodeps -ivh doca-runtime-kernel-*.aarch64.rpm && \
  dnf clean all

