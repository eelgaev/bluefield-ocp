LABEL "NVIDIA.OFED.version"="{{ D_OFED_VERSION }}"
LABEL "bluefield-ocp.version"="{{ BLUEFIELD_OCP_VERSION | default('') }}"
LABEL "bluefield-ocp.branch"="{{ BLUEFIELD_OCP_BRANCH | default('') }}"
