#% desc: Builder stage: compile OFED and BlueField SoC kernel modules from source
FROM {{ BUILDER_IMAGE }} AS builder
{% set doca_sources_url = DOCA_SOURCES_URL | default('https://linux.mellanox.com/public/repo/doca/' + (D_DOCA_URL_VERSION | default(D_DOCA_VERSION)) + '/SOURCES') %}
{% set ofed_src_archive = D_OFED_SRC_ARCHIVE | default('DOCA_BASE_SRC-' + (D_OFED_SRC_TYPE | default('')) + D_OFED_VERSION + '.tar.gz') %}

WORKDIR /root
{% if KERNEL_TYPE == '64k' %}

RUN \
  KVER=$(ls /usr/lib/modules | grep 64k | head -n1) && \
  echo "KVER=$KVER" >> /kernelver.env
{% else %}

RUN \
  KVER=$(ls /usr/lib/modules | grep -v 64k | head -n1) && \
  echo "KVER=$KVER" >> /kernelver.env
{% endif %}

# EPEL is now required to get the dkms package, we are also disabling module signing.

RUN \
  dnf install -y https://dl.fedoraproject.org/pub/epel/epel-release-latest-10.noarch.rpm && \
  dnf install -y automake autoconf libtool perl wget file && \
  dnf install -y dkms && \
  dnf clean all && \
  echo 'try_sign_modules=false' > /etc/dkms/framework.conf

RUN \
  wget --no-check-certificate -O {{ ofed_src_archive }} {{ doca_sources_url }}/mlnx_ofed/{{ ofed_src_archive }}; \
  if [ $? -ne 0 ]; then \
  wget --no-check-certificate -O {{ ofed_src_archive }} {{ doca_sources_url }}/MLNX_OFED/{{ ofed_src_archive }}; \
  fi

RUN \
  tar -xzf {{ ofed_src_archive }};

RUN \
  set -x && \
  source /kernelver.env && \
  cd DOCA_BASE_SRC-{{ D_OFED_VERSION }} && \
  \
  rpmbuild_kmod() { \
    MAKEFLAGS="-j$(nproc)" rpmbuild --rebuild "$1"-*.src.rpm \
      --define 'KMP 1' \
      --define "KVERSION $KVER" \
      --define "K_SRC /lib/modules/$KVER/build" \
      --with building_kmods \
      --define "_sourcedir $(pwd)" \
      --define 'debug_package %{nil}'; \
  } && \
  \
  rpmbuild_kmod mlnx-ofa_kernel || exit 1 && \
  rpm -i --nodeps /root/rpmbuild/RPMS/aarch64/mlnx-ofa_kernel-devel-*.aarch64.rpm || exit 1 && \
  \
  SRPMS=("kernel-mft" "iser" "isert" "xpmem" "mlnx-nfsrdma" "mlnx-nvme" "srp" "virtiofs") && \
  \
  for srpm in "${SRPMS[@]}"; do \
    rpmbuild_kmod "$srpm" || exit 1; \
  done && \
  rm -f /root/rpmbuild/RPMS/aarch64/*dkms* /root/rpmbuild/RPMS/aarch64/*devel* /root/rpmbuild/RPMS/aarch64/*source*

# mlnx-ofa_kernel is rebuilt first and its -devel RPM is installed with --nodeps
# so iser, isert, srp, and the other OFED kmods can compile against its headers.
# --nodeps skips the kmod dependency, which is tied to this builder's kernel
# release string.


RUN \
  SRPMS=("mlxbf-pka" "ipmb-host") && \
  wget -r -np -nd -A rpm -e robots=off "{{ doca_sources_url }}/SoC/" --accept-regex="$(IFS='|'; echo "(${SRPMS[*]/%/.+\.rpm})")"

RUN \
source /kernelver.env && \
  for package in *.src.rpm; do \
  rpmbuild --rebuild $package --define 'KMP 1' --define "KVERSION $KVER" --define "_sourcedir $(pwd)" --define "debug_package %{nil}" || exit 1; \
  rm -f $package; \
  done
  
######################################################################
